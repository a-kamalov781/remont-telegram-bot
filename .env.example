# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Telegram ID владельца/мастера (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789

# Название бизнеса — подставляется во все тексты
BUSINESS_NAME=Сервис «Ремонт Плюс»
BUSINESS_ADDRESS=Санкт-Петербург, Невский пр., 1
BUSINESS_PHONE=+7 (812) 000-00-00

# Рабочее время и шаг слота (минуты)
WORK_START=10:00
WORK_END=19:00
SLOT_MINUTES=60
# Дни недели для записи: 0=пн ... 6=вс
WORK_DAYS=0,1,2,3,4,5
# Сколько дней вперёд показывать
DAYS_AHEAD=7

# За сколько минут напоминать клиенту о визите
REMIND_BEFORE_MINUTES=120

# Google Sheets (необязательно). Путь к JSON сервисного аккаунта и ID таблицы
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=

# Путь к базе
DB_PATH=data/bot.db

# Часовой пояс
TZ=Europe/Moscow
