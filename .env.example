# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Telegram ID владельца/мастера (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789

# Ниша: repair | drycleaning | atelier | autoservice | appliance
NICHE=repair

# Витрина для одного бота: посетитель сам выбирает нишу и становится клиентом и мастером своей заявки
DEMO_MODE=false
# Контакт в финальном сообщении демо
DEMO_CONTACT=

# Название бизнеса — подставляется во все тексты. Пусто — название-пример из пресета ниши
BUSINESS_NAME=«Ремонт Плюс»
BUSINESS_ADDRESS=Санкт-Петербург, Невский пр., 1
BUSINESS_PHONE=+7 (812) 000-00-00

# Рабочее время
WORK_START=10:00
WORK_END=19:00
# Шаг слота в минутах. Пусто — из пресета ниши
SLOT_MINUTES=
# Дни недели для записи: 0=пн ... 6=вс
WORK_DAYS=0,1,2,3,4,5
# Сколько дней вперёд показывать
DAYS_AHEAD=7

# За сколько минут напоминать клиенту о визите
REMIND_BEFORE_MINUTES=120

# Google Sheets (необязательно). Путь к JSON сервисного аккаунта и ID таблицы
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=

# Путь к базе
DB_PATH=data/bot.db

# Часовой пояс
TZ=Europe/Moscow
